NoSubstitutionTemplate := StringLiteral "`(?:[^`\\$]|\$(?!\{)|\\[\s\S])*`" ;
TemplateHead := StringLiteral "`(?:[^`\\$]|\$(?!\{)|\\[\s\S])*\$\{" ;
TemplateMiddle := StringLiteral "\}(?:[^`\\$]|\$(?!\{)|\\[\s\S])*\$\{" ;
TemplateTail := StringLiteral "\}(?:[^`\\$]|\$(?!\{)|\\[\s\S])*`" ;
OptionalChainPunctuator := Identifier "\?\.(?![0-9])" ;
Comment := Comment "/\*[\s\S]*?\*/|//[^\r\n\u2028\u2029]*|\A\#\![^\r\n\u2028\u2029]*" ;
BindingIdentifier : IdentifierName | 'await' | 'of' | 'async' ;
BindingIdentifier__Await : IdentifierName | 'of' | 'async' ;
BindingPattern : ObjectBindingPattern | ArrayBindingPattern ;
BindingPattern__Await : ObjectBindingPattern__Await | ArrayBindingPattern__Await ;
Initializer : '=' AssignmentExpression ;
Initializer__Await : '=' AssignmentExpression__Await ;
SingleNameBinding : BindingIdentifier | BindingIdentifier Initializer ;
SingleNameBinding__Await : BindingIdentifier__Await | BindingIdentifier__Await Initializer__Await ;
BindingElement : SingleNameBinding | BindingPattern | BindingPattern Initializer ;
BindingElement__Await : SingleNameBinding__Await | BindingPattern__Await | BindingPattern__Await Initializer__Await ;
ObjectBindingPattern : '{' '}'
                     | '{' BindingPropertyList '}'
                     | '{' BindingPropertyList ',' '}'
                     | '{' BindingRestProperty '}'
                     | '{' BindingPropertyList ',' BindingRestProperty '}' ;
ObjectBindingPattern__Await : '{' '}'
                     | '{' BindingPropertyList__Await '}'
                     | '{' BindingPropertyList__Await ',' '}'
                     | '{' BindingRestProperty__Await '}'
                     | '{' BindingPropertyList__Await ',' BindingRestProperty__Await '}' ;
BindingPropertyList : BindingProperty | BindingPropertyList ',' BindingProperty ;
BindingPropertyList__Await : BindingProperty__Await | BindingPropertyList__Await ',' BindingProperty__Await ;
BindingProperty : SingleNameBinding | PropertyName ':' BindingElement ;
BindingProperty__Await : SingleNameBinding__Await | PropertyName__Await ':' BindingElement__Await ;
BindingRestProperty : '...' BindingIdentifier ;
BindingRestProperty__Await : '...' BindingIdentifier__Await ;
ArrayBindingPattern : '[' ']' | '[' ArrayBindingElements ']' ;
ArrayBindingPattern__Await : '[' ']' | '[' ArrayBindingElements__Await ']' ;
ArrayBindingElements : BindingElementList | BindingElision
                     | BindingElementList ',' | BindingElementList ',' BindingElision
                     | BindingRestElement | BindingElision BindingRestElement
                     | BindingElementList ',' BindingRestElement
                     | BindingElementList ',' BindingElision BindingRestElement ;
ArrayBindingElements__Await : BindingElementList__Await | BindingElision
                     | BindingElementList__Await ',' | BindingElementList__Await ',' BindingElision
                     | BindingRestElement__Await | BindingElision BindingRestElement__Await
                     | BindingElementList__Await ',' BindingRestElement__Await
                     | BindingElementList__Await ',' BindingElision BindingRestElement__Await ;
BindingElementList : BindingElement | BindingElision BindingElement
                   | BindingElementList ',' BindingElement | BindingElementList ',' BindingElision BindingElement ;
BindingElementList__Await : BindingElement__Await | BindingElision BindingElement__Await
                   | BindingElementList__Await ',' BindingElement__Await | BindingElementList__Await ',' BindingElision BindingElement__Await ;
BindingElision : ',' | BindingElision ',' ;
BindingRestElement : '...' BindingIdentifier | '...' BindingPattern ;
BindingRestElement__Await : '...' BindingIdentifier__Await | '...' BindingPattern__Await ;
FormalParameters : (FormalParameterList
                  | FormalParameterList ','
                  | FunctionRestParameter
                  | FormalParameterList ',' FunctionRestParameter)? ;
FormalParameters__Await : (FormalParameterList__Await
                  | FormalParameterList__Await ','
                  | FunctionRestParameter__Await
                  | FormalParameterList__Await ',' FunctionRestParameter__Await)? ;
FormalParameterList : FormalParameter | FormalParameterList ',' FormalParameter ;
FormalParameterList__Await : FormalParameter__Await | FormalParameterList__Await ',' FormalParameter__Await ;
FormalParameter : BindingElement ;
FormalParameter__Await : BindingElement__Await ;
FunctionRestParameter : BindingRestElement ;
FunctionRestParameter__Await : BindingRestElement__Await ;
StatementList : StatementListItem | StatementList StatementListItem ;
StatementList__Await : StatementListItem__Await | StatementList__Await StatementListItem__Await ;
StatementListItem : Statement | Declaration ;
StatementListItem__Await : Statement__Await | Declaration__Await ;
Declaration : FunctionDeclaration | LexicalDeclaration | ClassDeclaration | AsyncFunctionDeclaration | GeneratorDeclaration | AsyncGeneratorDeclaration ;
Declaration__Await : FunctionDeclaration__Await | LexicalDeclaration__Await | ClassDeclaration__Await | AsyncFunctionDeclaration__Await | GeneratorDeclaration__Await | AsyncGeneratorDeclaration__Await ;
Statement : Block | VariableStatement | EmptyStatement | ExpressionStatement
          | IfStatement | WhileStatement | DoWhileStatement | ForStatement
          | ForInStatement | ForOfStatement | ContinueStatement | BreakStatement
          | ReturnStatement | ThrowStatement | SwitchStatement | TryStatement
          | LabelledStatement | DebuggerStatement | ForAwaitOfStatement ;
Statement__Await : Block__Await | VariableStatement__Await | EmptyStatement | ExpressionStatement__Await
          | IfStatement__Await | WhileStatement__Await | DoWhileStatement__Await | ForStatement__Await
          | ForInStatement__Await | ForOfStatement__Await | ContinueStatement__Await | BreakStatement__Await
          | ReturnStatement__Await | ThrowStatement__Await | SwitchStatement__Await | TryStatement__Await
          | LabelledStatement__Await | DebuggerStatement | ForAwaitOfStatement__Await ;
Block : '{' '}' | '{' StatementList '}' ;
Block__Await : '{' '}' | '{' StatementList__Await '}' ;
EmptyStatement : ';' ;
StatementExpressionStart : {ExpressionStatementStart()}? ;
ExpressionStatement : StatementExpressionStart Expression ExpressionEnd ;
ExpressionStatement__Await : StatementExpressionStart Expression__Await ExpressionEnd ;
IfStatement : 'if' '(' Expression ')' Statement
            | 'if' '(' Expression ')' Statement 'else' Statement ;
IfStatement__Await : 'if' '(' Expression__Await ')' Statement__Await
            | 'if' '(' Expression__Await ')' Statement__Await 'else' Statement__Await ;
WhileStatement : 'while' '(' Expression ')' Statement ;
WhileStatement__Await : 'while' '(' Expression__Await ')' Statement__Await ;
DoWhileStatement : 'do' Statement 'while' '(' Expression ')' DoWhileEnd ;
DoWhileStatement__Await : 'do' Statement__Await 'while' '(' Expression__Await ')' DoWhileEnd ;
ForStatement : 'for' '(' ForInitializer? ';' Expression? ';' Expression? ')' Statement ;
ForStatement__Await : 'for' '(' ForInitializer__Await? ';' Expression__Await? ';' Expression__Await? ')' Statement__Await ;
ForInitializer : ExpressionNoIn | 'var' ForVariableDeclarationList | LetOrConst ForLexicalBindingList ;
ForInitializer__Await : ExpressionNoIn__Await | 'var' ForVariableDeclarationList__Await | LetOrConst ForLexicalBindingList__Await ;
ForVariableDeclarationList : ForVariableDeclaration | ForVariableDeclarationList ',' ForVariableDeclaration ;
ForVariableDeclarationList__Await : ForVariableDeclaration__Await | ForVariableDeclarationList__Await ',' ForVariableDeclaration__Await ;
ForVariableDeclaration : BindingIdentifier | BindingIdentifier InitializerNoIn | BindingPattern InitializerNoIn ;
ForVariableDeclaration__Await : BindingIdentifier__Await | BindingIdentifier__Await InitializerNoIn__Await | BindingPattern__Await InitializerNoIn__Await ;
ForLexicalBindingList : ForLexicalBinding | ForLexicalBindingList ',' ForLexicalBinding ;
