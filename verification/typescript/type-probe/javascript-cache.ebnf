AsyncConciseBody : FunctionBody__Await | {ArrowExpressionBody()}? AssignmentExpression__Await ;
AsyncArrowFunctionNoIn : CallExpression NoLineTerminator '=>' AsyncConciseBodyNoIn
                       | LeftHandSideExpression NoLineTerminator IdentifierReference NoLineTerminator '=>' AsyncConciseBodyNoIn ;
AsyncArrowFunctionNoIn__Await : CallExpression__Await NoLineTerminator '=>' AsyncConciseBodyNoIn
                       | LeftHandSideExpression__Await NoLineTerminator IdentifierReference__Await NoLineTerminator '=>' AsyncConciseBodyNoIn ;
AsyncConciseBodyNoIn : FunctionBody__Await | {ArrowExpressionBody()}? AssignmentExpressionNoIn__Await ;
YieldExpression : 'yield' {YieldEnd()}? | 'yield' NoLineTerminator AssignmentExpression
                | 'yield' NoLineTerminator '*' AssignmentExpression ;
YieldExpression__Await : 'yield' {YieldEnd()}? | 'yield' NoLineTerminator AssignmentExpression__Await
                | 'yield' NoLineTerminator '*' AssignmentExpression__Await ;
YieldExpressionNoIn : 'yield' {YieldEnd()}? | 'yield' NoLineTerminator AssignmentExpressionNoIn
                    | 'yield' NoLineTerminator '*' AssignmentExpressionNoIn ;
YieldExpressionNoIn__Await : 'yield' {YieldEnd()}? | 'yield' NoLineTerminator AssignmentExpressionNoIn__Await
                    | 'yield' NoLineTerminator '*' AssignmentExpressionNoIn__Await ;
AsyncModifier : {AsyncModifier()}? ;
ObjectAccessorName : {ObjectAccessor()}? PropertyName ;
ObjectAccessorName__Await : {ObjectAccessor()}? PropertyName__Await ;
ObjectMethod : PropertyName '(' FormalParameters ')' FunctionBody
             | PropertyName ObjectAccessorName '(' FormalParameters ')' FunctionBody ;
ObjectMethod__Await : PropertyName__Await '(' FormalParameters ')' FunctionBody
             | PropertyName__Await ObjectAccessorName__Await '(' FormalParameters ')' FunctionBody ;
