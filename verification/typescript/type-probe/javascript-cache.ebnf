                     | ClassElementName StaticGeneratorModifier '*' ClassElementName '(' FormalParameters ')' FunctionBody ;
ClassGeneratorMethod__Await : '*' ClassElementName__Await '(' FormalParameters ')' FunctionBody
                     | ClassElementName__Await StaticGeneratorModifier '*' ClassElementName__Await '(' FormalParameters ')' FunctionBody ;
ClassAsyncMethod : ClassElementName AsyncModifier ClassElementName '(' FormalParameters__Await ')' FunctionBody__Await
                 | ClassElementName AsyncModifier '*' ClassElementName '(' FormalParameters__Await ')' FunctionBody__Await
                 | ClassElementName ClassModifierName AsyncModifier ClassElementName '(' FormalParameters__Await ')' FunctionBody__Await
                 | ClassElementName ClassModifierName AsyncModifier '*' ClassElementName '(' FormalParameters__Await ')' FunctionBody__Await ;
ClassAsyncMethod__Await : ClassElementName__Await AsyncModifier ClassElementName__Await '(' FormalParameters__Await ')' FunctionBody__Await
                 | ClassElementName__Await AsyncModifier '*' ClassElementName__Await '(' FormalParameters__Await ')' FunctionBody__Await
                 | ClassElementName__Await ClassModifierName__Await AsyncModifier ClassElementName__Await '(' FormalParameters__Await ')' FunctionBody__Await
                 | ClassElementName__Await ClassModifierName__Await AsyncModifier '*' ClassElementName__Await '(' FormalParameters__Await ')' FunctionBody__Await ;
