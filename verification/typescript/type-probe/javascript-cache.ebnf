Script : StatementList? ;
Expression : AssignmentExpression | Expression ',' AssignmentExpression ;
Expression__Await : AssignmentExpression__Await | Expression__Await ',' AssignmentExpression__Await ;
AssignmentExpression : ConditionalExpression | LeftHandSideExpression AssignmentOperator AssignmentExpression | ArrowFunction | AsyncArrowFunction | YieldExpression ;
AssignmentExpression__Await : ConditionalExpression__Await | LeftHandSideExpression__Await AssignmentOperator AssignmentExpression__Await | ArrowFunction__Await | AsyncArrowFunction__Await | YieldExpression__Await ;
AssignmentOperator : '=' | '*=' | '/=' | '%=' | '+=' | '-=' | '<<=' | '>>=' | '>>>=' | '&=' | '^=' | '|=' | '**=' | '&&=' | '||=' | '??=' ;
ConditionalExpression : ShortCircuitExpression | ShortCircuitExpression '?' AssignmentExpression ':' AssignmentExpression ;
ConditionalExpression__Await : ShortCircuitExpression__Await | ShortCircuitExpression__Await '?' AssignmentExpression__Await ':' AssignmentExpression__Await ;
ShortCircuitExpression : LogicalORExpression | CoalesceExpression ;
ShortCircuitExpression__Await : LogicalORExpression__Await | CoalesceExpression__Await ;
LogicalORExpression : LogicalANDExpression | LogicalORExpression '||' LogicalANDExpression ;
LogicalORExpression__Await : LogicalANDExpression__Await | LogicalORExpression__Await '||' LogicalANDExpression__Await ;
LogicalANDExpression : BitwiseORExpression | LogicalANDExpression '&&' BitwiseORExpression ;
LogicalANDExpression__Await : BitwiseORExpression__Await | LogicalANDExpression__Await '&&' BitwiseORExpression__Await ;
CoalesceExpression : BitwiseORExpression '??' BitwiseORExpression | CoalesceExpression '??' BitwiseORExpression ;
CoalesceExpression__Await : BitwiseORExpression__Await '??' BitwiseORExpression__Await | CoalesceExpression__Await '??' BitwiseORExpression__Await ;
BitwiseORExpression : BitwiseXORExpression | BitwiseORExpression '|' BitwiseXORExpression ;
BitwiseORExpression__Await : BitwiseXORExpression__Await | BitwiseORExpression__Await '|' BitwiseXORExpression__Await ;
BitwiseXORExpression : BitwiseANDExpression | BitwiseXORExpression '^' BitwiseANDExpression ;
BitwiseXORExpression__Await : BitwiseANDExpression__Await | BitwiseXORExpression__Await '^' BitwiseANDExpression__Await ;
BitwiseANDExpression : EqualityExpression | BitwiseANDExpression '&' EqualityExpression ;
BitwiseANDExpression__Await : EqualityExpression__Await | BitwiseANDExpression__Await '&' EqualityExpression__Await ;
EqualityExpression : RelationalExpression | EqualityExpression EqualityOperator RelationalExpression ;
EqualityExpression__Await : RelationalExpression__Await | EqualityExpression__Await EqualityOperator RelationalExpression__Await ;
EqualityOperator : '==' | '!=' | '===' | '!==' ;
RelationalExpression : ShiftExpression | RelationalExpression RelationalOperator ShiftExpression | PrivateInExpression ;
RelationalExpression__Await : ShiftExpression__Await | RelationalExpression__Await RelationalOperator ShiftExpression__Await | PrivateInExpression__Await ;
RelationalOperator : '<' | '>' | '<=' | '>=' | 'instanceof' | 'in' ;
ShiftExpression : AdditiveExpression | ShiftExpression ShiftOperator AdditiveExpression ;
ShiftExpression__Await : AdditiveExpression__Await | ShiftExpression__Await ShiftOperator AdditiveExpression__Await ;
ShiftOperator : '<<' | '>>' | '>>>' ;
AdditiveExpression : MultiplicativeExpression | AdditiveExpression AdditiveOperator MultiplicativeExpression ;
AdditiveExpression__Await : MultiplicativeExpression__Await | AdditiveExpression__Await AdditiveOperator MultiplicativeExpression__Await ;
AdditiveOperator : '+' | '-' ;
MultiplicativeExpression : ExponentiationExpression | MultiplicativeExpression MultiplicativeOperator ExponentiationExpression ;
MultiplicativeExpression__Await : ExponentiationExpression__Await | MultiplicativeExpression__Await MultiplicativeOperator ExponentiationExpression__Await ;
MultiplicativeOperator : '*' | '/' | '%' ;
ExponentiationExpression : UnaryExpression | UpdateExpression '**' ExponentiationExpression ;
ExponentiationExpression__Await : UnaryExpression__Await | UpdateExpression__Await '**' ExponentiationExpression__Await ;
UnaryExpression : UpdateExpression | UnaryOperator UnaryExpression ;
UnaryExpression__Await : UpdateExpression__Await | UnaryOperator UnaryExpression__Await | AwaitExpression__Await ;
UnaryOperator : 'delete' | 'void' | 'typeof' | '+' | '-' | '~' | '!' ;
UpdateExpression : SimpleUpdateExpression | LeftHandSideExpression NoLineTerminator PostfixOperator | PrefixOperator UnaryExpression ;
UpdateExpression__Await : SimpleUpdateExpression__Await | LeftHandSideExpression__Await NoLineTerminator PostfixOperator | PrefixOperator UnaryExpression__Await ;
SimpleUpdateExpression : LeftHandSideExpression {NoPostfix()}? ;
SimpleUpdateExpression__Await : LeftHandSideExpression__Await {NoPostfix()}? ;
PrefixOperator : '++' | '--' ;
PostfixOperator : '++' | '--' ;
NoLineTerminator : {NoLineBreak()}? ;
LeftHandSideExpression : NewExpression | CallExpression | OptionalExpression ;
LeftHandSideExpression__Await : NewExpression__Await | CallExpression__Await | OptionalExpression__Await ;
NewExpression : MemberExpression | 'new' NewExpression ;
NewExpression__Await : MemberExpression__Await | 'new' NewExpression__Await ;
MemberExpression : PrimaryExpression | SuperProperty | NewTarget | ImportMeta | MemberExpression MemberAccess | MemberExpression TaggedTemplate | 'new' MemberExpression Arguments ;
MemberExpression__Await : PrimaryExpression__Await | SuperProperty__Await | NewTarget | ImportMeta | MemberExpression__Await MemberAccess__Await | MemberExpression__Await TaggedTemplate__Await | 'new' MemberExpression__Await Arguments__Await ;
CallExpression : MemberExpression Arguments | SuperCall | ImportCall | CallExpression Arguments | CallExpression MemberAccess | CallExpression TaggedTemplate ;
CallExpression__Await : MemberExpression__Await Arguments__Await | SuperCall__Await | ImportCall__Await | CallExpression__Await Arguments__Await | CallExpression__Await MemberAccess__Await | CallExpression__Await TaggedTemplate__Await ;
MemberAccess : '.' PropertyIdentifierName | '[' Expression ']' | PrivateMemberAccess ;
MemberAccess__Await : '.' PropertyIdentifierName | '[' Expression__Await ']' | PrivateMemberAccess ;
OptionalExpression : MemberExpression OptionalChain | CallExpression OptionalChain | OptionalExpression OptionalChain ;
OptionalExpression__Await : MemberExpression__Await OptionalChain__Await | CallExpression__Await OptionalChain__Await | OptionalExpression__Await OptionalChain__Await ;
OptionalChain : OptionalChainStart | OptionalChain MemberAccess | OptionalChain Arguments ;
OptionalChain__Await : OptionalChainStart__Await | OptionalChain__Await MemberAccess__Await | OptionalChain__Await Arguments__Await ;
OptionalChainStart : OptionalChainPunctuator PropertyIdentifierName | OptionalChainPunctuator PrivateIdentifier | OptionalChainPunctuator '[' Expression ']' | OptionalChainPunctuator Arguments ;
OptionalChainStart__Await : OptionalChainPunctuator PropertyIdentifierName | OptionalChainPunctuator PrivateIdentifier | OptionalChainPunctuator '[' Expression__Await ']' | OptionalChainPunctuator Arguments__Await ;
Arguments : '(' ')' | '(' ArgumentList ')' | '(' ArgumentList ',' ')' ;
Arguments__Await : '(' ')' | '(' ArgumentList__Await ')' | '(' ArgumentList__Await ',' ')' ;
ArgumentList : Argument | ArgumentList ',' Argument ;
ArgumentList__Await : Argument__Await | ArgumentList__Await ',' Argument__Await ;
Argument : AssignmentExpression | SpreadElement ;
Argument__Await : AssignmentExpression__Await | SpreadElement__Await ;
SpreadElement : '...' AssignmentExpression ;
SpreadElement__Await : '...' AssignmentExpression__Await ;
PrimaryExpression : IdentifierReference | Literal | 'this' | ParenthesizedExpression | ArrayLiteral | ObjectLiteral | TemplateLiteral | FunctionExpression | ClassExpression | AsyncFunctionExpression | GeneratorExpression | AsyncGeneratorExpression ;
PrimaryExpression__Await : IdentifierReference__Await | Literal | 'this' | ParenthesizedExpression__Await | ArrayLiteral__Await | ObjectLiteral__Await | TemplateLiteral__Await | FunctionExpression | ClassExpression__Await | AsyncFunctionExpression | GeneratorExpression | AsyncGeneratorExpression ;
ParenthesizedExpression : '(' Expression ')' | '(' ')' | '(' Expression ',' ')'
                        | '(' Expression ',' SpreadElement ')' | '(' SpreadElement ')' ;
ParenthesizedExpression__Await : '(' Expression__Await ')' | '(' ')' | '(' Expression__Await ',' ')'
                        | '(' Expression__Await ',' SpreadElement__Await ')' | '(' SpreadElement__Await ')' ;
Literal : NumericLiteral | StringLiteral | RegularExpressionLiteral | 'null' | 'true' | 'false' ;
TemplateLiteral : TemplateContent ;
TemplateLiteral__Await : TemplateContent__Await ;
TaggedTemplate : TemplateContent ;
TaggedTemplate__Await : TemplateContent__Await ;
TemplateContent : NoSubstitutionTemplate | TemplateHead Expression TemplateSpans ;
TemplateContent__Await : NoSubstitutionTemplate | TemplateHead Expression__Await TemplateSpans__Await ;
TemplateSpans : TemplateTail | TemplateMiddleList TemplateTail ;
TemplateSpans__Await : TemplateTail | TemplateMiddleList__Await TemplateTail ;
TemplateMiddleList : TemplateMiddle Expression | TemplateMiddleList TemplateMiddle Expression ;
TemplateMiddleList__Await : TemplateMiddle Expression__Await | TemplateMiddleList__Await TemplateMiddle Expression__Await ;
IdentifierReference : IdentifierName | 'await' | 'of' | 'async' ;
IdentifierReference__Await : IdentifierName | 'of' | 'async' ;
PropertyIdentifierName : IdentifierName | ReservedWord | 'of' | 'async' ;
ReservedWord : 'await' | 'break' | 'case' | 'catch' | 'class' | 'const' | 'continue' | 'debugger' | 'default' | 'delete' | 'do' | 'else' | 'enum' | 'export' | 'extends' | 'false' | 'finally' | 'for' | 'function' | 'if' | 'import' | 'in' | 'instanceof' | 'new' | 'null' | 'return' | 'super' | 'switch' | 'this' | 'throw' | 'true' | 'try' | 'typeof' | 'var' | 'void' | 'while' | 'with' | 'yield' | 'let' | 'static' | 'implements' | 'interface' | 'package' | 'private' | 'protected' | 'public' ;
ArrayLiteral : '[' ']' | '[' ArrayElements ']' ;
ArrayLiteral__Await : '[' ']' | '[' ArrayElements__Await ']' ;
ArrayElements : ArrayElementList | ArrayElision | ArrayElementList ',' | ArrayElementList ',' ArrayElision ;
ArrayElements__Await : ArrayElementList__Await | ArrayElision | ArrayElementList__Await ',' | ArrayElementList__Await ',' ArrayElision ;
ArrayElementList : ArrayElement | ArrayElision ArrayElement
                 | ArrayElementList ',' ArrayElement | ArrayElementList ',' ArrayElision ArrayElement ;
ArrayElementList__Await : ArrayElement__Await | ArrayElision ArrayElement__Await
                 | ArrayElementList__Await ',' ArrayElement__Await | ArrayElementList__Await ',' ArrayElision ArrayElement__Await ;
ArrayElision : ',' | ArrayElision ',' ;
ArrayElement : AssignmentExpression | SpreadElement ;
ArrayElement__Await : AssignmentExpression__Await | SpreadElement__Await ;
ObjectLiteral : '{' '}' | '{' PropertyDefinitionList '}' | '{' PropertyDefinitionList ',' '}' ;
ObjectLiteral__Await : '{' '}' | '{' PropertyDefinitionList__Await '}' | '{' PropertyDefinitionList__Await ',' '}' ;
PropertyDefinitionList : PropertyDefinition | PropertyDefinitionList ',' PropertyDefinition ;
PropertyDefinitionList__Await : PropertyDefinition__Await | PropertyDefinitionList__Await ',' PropertyDefinition__Await ;
PropertyDefinition : IdentifierReference | CoverInitializedName | PropertyName ':' AssignmentExpression | SpreadElement | ObjectMethod | ObjectAsyncMethod | ObjectGeneratorMethod ;
PropertyDefinition__Await : IdentifierReference__Await | CoverInitializedName__Await | PropertyName__Await ':' AssignmentExpression__Await | SpreadElement__Await | ObjectMethod__Await | ObjectAsyncMethod__Await | ObjectGeneratorMethod__Await ;
CoverInitializedName : IdentifierReference '=' AssignmentExpression ;
CoverInitializedName__Await : IdentifierReference__Await '=' AssignmentExpression__Await ;
PropertyName : PropertyIdentifierName | StringLiteral | NumericLiteral | '[' AssignmentExpression ']' ;
PropertyName__Await : PropertyIdentifierName | StringLiteral | NumericLiteral | '[' AssignmentExpression__Await ']' ;
