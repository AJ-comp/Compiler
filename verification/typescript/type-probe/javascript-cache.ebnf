AsyncGeneratorExpression : AsyncFunctionStart '*' '(' FormalParameters__Await ')' FunctionBody__Await
                         | AsyncFunctionStart '*' BindingIdentifier__Await '(' FormalParameters__Await ')' FunctionBody__Await ;
AsyncArrowFunction : CallExpression NoLineTerminator '=>' AsyncConciseBody
                   | LeftHandSideExpression NoLineTerminator IdentifierReference NoLineTerminator '=>' AsyncConciseBody ;
