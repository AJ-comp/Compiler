ModuleItemList : ModuleItem | ModuleItemList ModuleItem ;
ModuleItemList__Await : ModuleItem__Await | ModuleItemList__Await ModuleItem__Await ;
ModuleItem : ImportDeclaration | ExportDeclaration | StatementListItem ;
ModuleItem__Await : ImportDeclaration__Await | ExportDeclaration__Await | StatementListItem__Await ;
ImportDeclaration : 'import' ImportClause FromClause ImportAttributes? ModuleEnd
                  | 'import' ModuleSpecifier ImportAttributes? ModuleEnd ;
ImportDeclaration__Await : 'import' ImportClause__Await FromClause ImportAttributes? ModuleEnd
                  | 'import' ModuleSpecifier ImportAttributes? ModuleEnd ;
ImportClause : ImportedBinding | ImportedBinding ',' NameSpaceImport
             | ImportedBinding ',' NamedImports | NameSpaceImport | NamedImports ;
ImportClause__Await : ImportedBinding__Await | ImportedBinding__Await ',' NameSpaceImport__Await
             | ImportedBinding__Await ',' NamedImports__Await | NameSpaceImport__Await | NamedImports__Await ;
ImportedBinding : BindingIdentifier ;
ImportedBinding__Await : BindingIdentifier__Await ;
NameSpaceImport : '*' ModuleAs ImportedBinding ;
NameSpaceImport__Await : '*' ModuleAs ImportedBinding__Await ;
NamedImports : '{' '}' | '{' ImportSpecifierList '}' | '{' ImportSpecifierList ',' '}' ;
NamedImports__Await : '{' '}' | '{' ImportSpecifierList__Await '}' | '{' ImportSpecifierList__Await ',' '}' ;
ImportSpecifierList : ImportSpecifier | ImportSpecifierList ',' ImportSpecifier ;
ImportSpecifierList__Await : ImportSpecifier__Await | ImportSpecifierList__Await ',' ImportSpecifier__Await ;
ImportSpecifier : ModuleExportName | ModuleExportName ModuleAs ImportedBinding ;
ImportSpecifier__Await : ModuleExportName | ModuleExportName ModuleAs ImportedBinding__Await ;
ModuleExportName : PropertyIdentifierName | StringLiteral ;
ModuleSpecifier : StringLiteral ;
FromClause : ModuleFrom ModuleSpecifier ;
ModuleFrom : {ModuleFrom()}? IdentifierName ;
ModuleAs : {ModuleAs()}? IdentifierName ;
ImportAttributes : 'with' '{' '}' | 'with' '{' WithEntries '}' | 'with' '{' WithEntries ',' '}' ;
WithEntries : WithEntry | WithEntries ',' WithEntry ;
WithEntry : AttributeKey ':' StringLiteral ;
AttributeKey : PropertyIdentifierName | StringLiteral ;
ExportDeclaration : 'export' NamedExports ExportNamedEnd
                  | 'export' NamedExports FromClause ImportAttributes? ModuleEnd
                  | 'export' '*' FromClause ImportAttributes? ModuleEnd
                  | 'export' '*' ModuleAs ModuleExportName FromClause ImportAttributes? ModuleEnd
                  | 'export' Declaration | 'export' VariableStatement
                  | DefaultExportFunction | DefaultExportClass | ExportDefaultExpression ;
ExportDeclaration__Await : 'export' NamedExports ExportNamedEnd
                  | 'export' NamedExports FromClause ImportAttributes? ModuleEnd
                  | 'export' '*' FromClause ImportAttributes? ModuleEnd
                  | 'export' '*' ModuleAs ModuleExportName FromClause ImportAttributes? ModuleEnd
                  | 'export' Declaration__Await | 'export' VariableStatement__Await
                  | DefaultExportFunction | DefaultExportClass__Await | ExportDefaultExpression__Await ;
NamedExports : '{' '}' | '{' ExportSpecifierList '}' | '{' ExportSpecifierList ',' '}' ;
ExportSpecifierList : ExportSpecifier | ExportSpecifierList ',' ExportSpecifier ;
ExportSpecifier : ModuleExportName | ModuleExportName ModuleAs ModuleExportName ;
DefaultExportFunction : 'export' 'default' FunctionExpression | 'export' 'default' AsyncFunctionExpression
                      | 'export' 'default' GeneratorExpression | 'export' 'default' AsyncGeneratorExpression ;
DefaultExportClass : 'export' 'default' ClassExpression ;
DefaultExportClass__Await : 'export' 'default' ClassExpression__Await ;
ExportDefaultExpression : 'export' 'default' {DefaultExportExpression()}? AssignmentExpression ExpressionEnd ;
ExportDefaultExpression__Await : 'export' 'default' {DefaultExportExpression()}? AssignmentExpression__Await ExpressionEnd ;
ModuleEnd : ';' | {ModuleEnd()}? ;
ExportNamedEnd : ';' | {ExportNamedEnd()}? ;
ImportCall : 'import' '(' AssignmentExpression ')'
           | 'import' '(' AssignmentExpression ',' ')'
           | 'import' '(' AssignmentExpression ',' AssignmentExpression ')'
           | 'import' '(' AssignmentExpression ',' AssignmentExpression ',' ')' ;
ImportCall__Await : 'import' '(' AssignmentExpression__Await ')'
           | 'import' '(' AssignmentExpression__Await ',' ')'
           | 'import' '(' AssignmentExpression__Await ',' AssignmentExpression__Await ')'
           | 'import' '(' AssignmentExpression__Await ',' AssignmentExpression__Await ',' ')' ;
ImportMeta : 'import' '.' PropertyIdentifierName ;
AwaitExpression : 'await' UnaryExpression ;
AwaitExpression__Await : 'await' UnaryExpression__Await ;
ForAwaitOfStatement : 'for' 'await' '(' LeftHandSideExpression 'of' AssignmentExpression ')' Statement
                    | 'for' 'await' '(' ForDeclaration 'of' AssignmentExpression ')' Statement ;
ForAwaitOfStatement__Await : 'for' 'await' '(' LeftHandSideExpression__Await 'of' AssignmentExpression__Await ')' Statement__Await
                    | 'for' 'await' '(' ForDeclaration__Await 'of' AssignmentExpression__Await ')' Statement__Await ;
AsyncFunctionStart : {AsyncFunctionStart()}? 'async' NoLineTerminator 'function' ;
AsyncFunctionDeclaration : AsyncFunctionStart BindingIdentifier '(' FormalParameters__Await ')' FunctionBody__Await ;
AsyncFunctionDeclaration__Await : AsyncFunctionStart BindingIdentifier__Await '(' FormalParameters__Await ')' FunctionBody__Await ;
AsyncFunctionExpression : AsyncFunctionStart '(' FormalParameters__Await ')' FunctionBody__Await
                        | AsyncFunctionStart BindingIdentifier__Await '(' FormalParameters__Await ')' FunctionBody__Await ;
GeneratorDeclaration : 'function' '*' BindingIdentifier '(' FormalParameters ')' FunctionBody ;
