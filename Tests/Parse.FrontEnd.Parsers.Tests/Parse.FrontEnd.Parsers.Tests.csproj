<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Transitive LiteDB 5.0.11 (from Parse.FrontEnd) trips NU1903/NU1904; not relevant to tests. -->
    <NoWarn>$(NoWarn);NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The pure parser engine + the example grammars it is exercised with. -->
    <ProjectReference Include="..\..\src\FrontEnd\Parse.FrontEnd.Parsers\Parse.FrontEnd.Parsers.csproj" />
    <ProjectReference Include="..\..\src\FrontEnd\Parse.FrontEnd.Grammars\Parse.FrontEnd.Grammars.csproj" />
    <ProjectReference Include="..\..\src\FrontEnd\Parse.FrontEnd.Grammars.Ebnf\Parse.FrontEnd.Grammars.Ebnf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise the canonical grammar/corpus, rather than maintaining test-only copies. -->
    <None Include="..\..\grammars\c\c11-core.ebnf" Link="Fixtures\C\c11-core.ebnf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\grammars\c\c11-core.cases.json" Link="Fixtures\C\c11-core.cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
