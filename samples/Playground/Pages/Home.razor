@page "/"
@using System.Text.Json
@using Janglim.Playground.Models
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Janglim Playground</PageTitle>

<div @ref="_host" class="playground-host">
    <div class="playground-loading" role="status" aria-live="polite">
        @if (_mountError is not null)
        {
            <span data-bootstrap-i18n="Unable to load the playground:">Unable to load the playground:</span>
            <span>@_mountError</span>
        }
        else
        {
            <span data-bootstrap-i18n="Loading Janglim Playground…">Loading Janglim Playground…</span>
        }
    </div>
</div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _reference;
    private string? _mountError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _reference = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./ui/playground.js");
            await _module.InvokeVoidAsync("mountPlayground", _host, _reference);
        }
        catch (JSException ex)
        {
            _mountError = ex.Message;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public string Parse(string grammarText, string inputText) =>
        JsonSerializer.Serialize(PlaygroundSession.Create(grammarText, inputText),
            PlaygroundJsonContext.Default.PlaygroundSession);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unmountPlayground", _host);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser has already released the React host.
        }
        finally
        {
            _reference?.Dispose();
        }
    }
}
