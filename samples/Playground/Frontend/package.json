{
  "name": "janglim-playground-ui",
  "version": "1.0.0",
  "description": "A multilingual, browser-local EBNF and LALR parser playground with interactive syntax trees, parsing tables, execution traces, and linked source highlighting.",
  "keywords": [
    "janglim",
    "parser",
    "parser-generator",
    "lalr",
    "ebnf",
    "grammar",
    "syntax-tree",
    "compiler",
    "lexer",
    "playground",
    "webassembly",
    "react",
    "language-tooling"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --test scripts/test-language.mjs",
    "dev": "vite"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
