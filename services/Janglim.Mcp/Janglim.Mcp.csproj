<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
    <Description>Stateless remote MCP tools for retrieving versioned grammar baselines, validating Janglim EBNF, inspecting LALR conflicts, parsing input, and running example tests in isolated workers. Includes the read-only C11 Core grammar catalog.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <ProjectReference Include="../../src/FrontEnd/Parse.FrontEnd.Grammars.Ebnf/Parse.FrontEnd.Grammars.Ebnf.csproj" />
    <ProjectReference Include="../../src/FrontEnd/Parse.FrontEnd.Parsers/Parse.FrontEnd.Parsers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Release-owned baseline, not a runtime-writable project file. -->
    <EmbeddedResource Include="../../grammars/c/c11-core.ebnf" LogicalName="Janglim.Mcp.Grammars.c11-core.ebnf" />
    <Content Include="../../grammars/javascript/unicode/LICENSE.txt" Link="licenses/Unicode-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
